# Supabase — Settings > Data API (URL) et Settings > API Keys (clé)
#
# La clé publishable (sb_publishable_...) remplace l'ancienne clé anon.
# Elle est publique par nature : elle part dans le JavaScript du navigateur et
# ne donne accès qu'à ce que les politiques RLS autorisent.
#
# Ne jamais mettre ici la clé secrète (sb_secret_...) : elle contourne la RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Tâche planifiée du récapitulatif quotidien -----------------------------
# Ces trois variables n'ont PAS de préfixe NEXT_PUBLIC : elles ne doivent
# jamais partir au navigateur.
#
# Clé secrète Supabase (Settings > API Keys > Secret keys). Elle contourne
# toute la RLS : le cron s'exécute sans session et n'a pas d'autre moyen de
# lire la base. À ne mettre nulle part ailleurs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# WasenderAPI, même compte que les autres projets
WASENDER_API_KEY=
WASENDER_SESSION_ID=

# Chaîne au hasard : Vercel l'envoie en en-tête Authorization sur le cron,
# ce qui empêche n'importe qui de déclencher l'envoi depuis l'extérieur.
CRON_SECRET=
